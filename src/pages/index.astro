---
import "../styles/global.css";

/* ==========================================================================
   Datos del sitio
   ========================================================================== */
const siteUrl = 'https://origennatural.co/';
const title = 'ORIGEN Natural | Línea ORIGEN natural con Resveratrol';
const description =
  'Línea ORIGEN Natural | ORIGEN natural 15 Comprimidos | ORIGEN natural 30 Comprimidos | ORIGEN natural con Resveratrol 350 mL ORIGEN natural con Resveratrol 28.5 mL';
const ogImage = `${siteUrl}images/og-origen-1200x630.jpg`;
const ogImageAlt =
  'Línea ORIGEN Natural | ORIGEN natural 15 Comprimidos | ORIGEN natural 30 Comprimidos | ORIGEN natural con Resveratrol 350 mL ORIGEN natural con Resveratrol 28.5';

/* ==========================================================================
   Datos estructurados (schema.org)
   ========================================================================== */
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      url: siteUrl,
      name: 'ORIGEN natural',
      alternateName: ['ORIGEN', 'origen natural'],
      inLanguage: 'es-CO',
      publisher: { '@id': `${siteUrl}#organization` },
    },
    {
      '@type': 'Organization',
      '@id': `${siteUrl}#organization`,
      name: 'ORIGEN natural',
      alternateName: 'ORIGEN',
      url: siteUrl,
      logo: `${siteUrl}icons/origen-512.png`,
      description:
        'Marca de productos naturales de la línea ORIGEN natural natural, con sede en Cali, Colombia.',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Cali',
        addressRegion: 'Valle del Cauca',
        addressCountry: 'CO',
      },
      email: 'ventas@origennatural.co',
      // Descomenta y completa cuando tengas redes con el mismo nombre:
      // sameAs: [
      //   'https://www.instagram.com/origennatural.co',
      //   'https://www.facebook.com/origennatural.co',
      // ],
    },
  ],
};

/* ==========================================================================
   Contenido de la página
   ========================================================================== */
const navLinks = [
  { href: '#producto', label: 'Producto' },
  { href: '#zarzilla-alfa', label: 'Zarzilla Alfa' },
  { href: '#detalle', label: 'Detalles' },
  { href: '#marca', label: 'Marca' },
  { href: '#contacto', label: 'Contacto' },
];

const specs = [
  { value: '350 mL', label: 'Formato hogar' },
  { value: '30 mL', label: 'Formato individual' },
  { value: '1 fl oz', label: 'Presentación individual' },
];

const zarzillaSpecs = [
  { value: '500 mL', label: 'Presentación' },
  { value: 'Vitamina C y Zinc', label: 'Fortificado con' },
  { value: 'Zarzaparrilla y sábila', label: 'Ingredientes destacados' },
];

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="es-CO">
  <head>
    <!-- Base -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="canonical" href="https://origennatural.co/" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:site_name" content="ORIGEN natural" />
    <meta property="og:locale" content="es_CO" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Datos estructurados -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- PWA e iconos -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/png" href="/icons/origen-192.png" />
    <link rel="apple-touch-icon" href="/icons/origen-192.png" />

    <!-- Fuentes -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Playfair+Display:wght@500;600&display=swap"
      rel="stylesheet"
    />

  <!-- CSS -->
  <link rel="stylesheet" href="/css/styles.css" />
  </head>

  <body>
    <!-- ================= NAVBAR ================= -->
    <header class="navbar">
      <button id="install-pwa" class="install-button" hidden>
        Instalar ORIGEN
      </button>

      <a href="/" class="logo">ORIGEN</a>

      <nav aria-label="Principal">
        {navLinks.map(({ href, label }) => <a href={href}>{label}</a>)}
      </nav>
    </header>

    <main>
      <!-- ================= HERO ================= -->
      <section class="hero">
        <div class="hero-content">
          <p class="eyebrow">Cali, Colombia</p>

          <h1>
            ORIGEN natural
            <span>productos naturales de la línea ORIGEN natural.</span>
          </h1>

          <p class="hero-text">
            ORIGEN natural es una marca de producto natural de la línea ORIGEN natural,
            de Cali, Colombia: una bebida a base de agua con fruta, en 350 mL
            para tener en casa y 30 mL / 1 fl oz para llevar.
          </p>

          <a href="#producto" class="button">Conocer ORIGEN</a>
        </div>

        <div class="hero-product">
          <div class="glow"></div>

          <img
            src="/images/-origen-25ml.webp"
            alt=" de ORIGEN natural, bebida a base de agua con fruta"
            width="430"
            height="650"
            fetchpriority="high"
          />
        </div>
      </section>

      <!-- ================= PRODUCTO ================= -->
      <section id="producto" class="product-section">
        <div class="section-image">
          <img
            src="/images/-origen-25ml.webp"
            alt=" individual de ORIGEN natural de 30 mL"
            width="380"
            height="570"
            loading="lazy"
          />
        </div>

        <div class="section-content">
          <p class="eyebrow">ORIGEN natural</p>

          <h2>
            Una fórmula.
            <span>Dos formatos.</span>
          </h2>

          <p>
            ORIGEN natural es una bebida a base de agua con fruta. Su propuesta
            contempla una presentación de 350 mL para tener en casa y una
            presentación individual de 30 mL / 1 fl oz para llevar.
          </p>

          <div class="specs">
            {specs.map(({ value, label }) => (
              <div>
                <strong>{value}</strong>
                <span>{label}</span>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- ================= ZARZILLA ALFA ================= -->
      <section id="zarzilla-alfa" class="product-section reverse">
        <div class="section-image">
          <img
            src="/images/zarzilla-alfa.png"
            alt="Botella verde de Zarzilla Alfa, bebida a base de zumo de frutas con corteza de zarzaparrilla y sábila, 500 mL"
            width="380"
            height="570"
            loading="lazy"
          />
        </div>

        <div class="section-content">
          <p class="eyebrow">NUEVO PRODUCTO</p>

          <h2>
            Zarzilla Alfa
            <span>Bebida a base de zumo de frutas.</span>
          </h2>

          <p>
            Zarzilla Alfa es una bebida a base de zumo de frutas, fortificada
            con vitamina C y zinc, con corteza de zarzaparrilla y sábila.
            Presentación de 500 mL.
          </p>

          <div class="specs">
            {zarzillaSpecs.map(({ value, label }) => (
              <div>
                <strong>{value}</strong>
                <span>{label}</span>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- ================= DETALLE ================= -->
      <section id="detalle" class="detail-section">
        <div>
          <p class="eyebrow">LA PROPUESTA</p>

          <h2>
            ORIGEN natural
            <span>se adapta.</span>
          </h2>

          <p>
            El formato de 350 mL está pensado para tener ORIGEN disponible en
            casa. El formato individual de 30 mL / 1 fl oz está pensado para
            llevar fácilmente contigo.
          </p>

          <p>
            La presentación, el contenido y la información del producto se
            irán actualizando conforme avance la producción y tengamos la
            información técnica definitiva.
          </p>
        </div>

        <div class="cap-card">
          <img
            src="/images/tapa-blanca.webp"
            alt="Detalle de ORIGEN natural"
            width="400"
            height="400"
            loading="lazy"
          />
        </div>
      </section>

      <!-- ================= MARCA ================= -->
      <section id="marca" class="brand-section">
        <p class="eyebrow">LA MARCA</p>

        <h2>
          línea ORIGEN natural
          <span>desde Cali, Colombia.</span>
        </h2>

        <p>
          ORIGEN natural es una línea de productos naturales creada en Cali, Valle del
          Cauca. ORIGEN natural es su bebida a base de agua con fruta, pensada
          para acompañarte en casa y fuera de ella.
        </p>
      </section>

      <!-- ================= CONTACTO ================= -->
      <section id="contacto" class="cta">
        <p class="eyebrow">ORIGEN natural</p>

        <h2>
          Una fórmula.
          <span>Dos formas de llevarla.</span>
        </h2>

        <a href="mailto:ventas@origennatural.co" class="button">Contactar</a>
      </section>
    </main>

    <!-- ================= FOOTER ================= -->
    <footer>
      <span>© {year} ORIGEN natural · Cali, Colombia</span>
      <span>ORIGEN natural</span>
    </footer>

    <!-- ================= PWA ================= -->
    <script>
      // Service worker
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js');
        });
      }

      // Botón "Instalar ORIGEN natural"
      let deferredPrompt: any = null;
      const installButton =
        document.querySelector<HTMLButtonElement>('#install-pwa');

      const hideInstallButton = () => {
        if (installButton) installButton.hidden = true;
      };

      window.addEventListener('beforeinstallprompt', (event) => {
        event.preventDefault();
        deferredPrompt = event;
        if (installButton) installButton.hidden = false;
      });

      installButton?.addEventListener('click', async () => {
        if (!deferredPrompt) return;

        deferredPrompt.prompt();
        await deferredPrompt.userChoice;

        deferredPrompt = null;
        hideInstallButton();
      });

      window.addEventListener('appinstalled', hideInstallButton);
    </script>
  </body>
</html>
